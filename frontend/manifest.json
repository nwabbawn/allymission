{
  "manifest_version": 3,
  "name": "Alloy Mission Capture",
  "description": "Collect user info, request screenshot permission, capture and upload to backend.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Alloy Mission"
  },
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
